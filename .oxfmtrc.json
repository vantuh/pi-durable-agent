{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "arrowParens": "always",
    "endOfLine": "lf",
    "insertFinalNewline": true,
    "sortImports": true,
    "sortPackageJson": true,
    "sortTailwindcss": true,
    "ignorePatterns": ["dist", "node_modules", "pnpm-lock.yaml", ".agents", "skills-lock.json"]
}
