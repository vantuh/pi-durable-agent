{
    "name": "pi-durable-agent",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "prepare": "git config core.hooksPath .githooks",
        "dev": "node scripts/dev.ts",
        "dev:web": "node scripts/dev.ts web",
        "dev:server": "node scripts/dev.ts server",
        "serve": "node scripts/serve.ts",
        "start": "pnpm build && node scripts/serve.ts",
        "build": "vite build",
        "preview": "vite preview",
        "preview:phone": "pnpm build && vite preview --host --port 5192 --strictPort",
        "test": "node --test test/ extensions/",
        "check": "oxfmt --check && oxlint --type-aware && tsc --noEmit",
        "fix": "oxfmt && oxlint --type-aware --fix"
    },
    "dependencies": {
        "@earendil-works/chord": "1.5.0",
        "@earendil-works/pi-ai": "1.5.0",
        "@earendil-works/pi-coding-agent": "1.5.0",
        "@earendil-works/pi-durable": "1.5.0",
        "@hono/node-server": "^2.1.6",
        "@hono/zod-validator": "^0.9.1",
        "@pierre/diffs": "1.6.4",
        "@pierre/highlights": "0.4.0",
        "clsx": "^2.1.1",
        "cmdk": "1.1.1",
        "hono": "^4.13.16",
        "lucide-react": "^1.70.0",
        "radix-ui": "1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "10.1.0",
        "react-zoom-pan-pinch": "4.2.0",
        "remark-gfm": "4.0.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "linkedom": "0.18.15",
        "oxfmt": "^0.77.0",
        "oxlint": "^1.92.0",
        "oxlint-tsgolint": "^7.0.2005",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.6"
    },
    "engines": {
        "node": ">=26"
    }
}
