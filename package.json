{
    "name": "pi-durable-agent",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "prepare": "git config core.hooksPath .githooks",
        "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
        "dev": "node scripts/dev.ts",
        "serve": "node scripts/serve.ts",
        "start": "pnpm build && node scripts/serve.ts",
        "build": "vite build",
        "preview": "vite preview",
        "preview:phone": "pnpm build && vite preview --host --port 5192 --strictPort",
        "test": "node --test test/ extensions/",
        "check": "oxfmt --check && oxlint --type-aware && tsc --noEmit",
        "fix": "oxfmt && oxlint --type-aware --fix"
    },
    "dependencies": {
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/sortable": "10.0.0",
        "@earendil-works/chord": "1.4.0",
        "@earendil-works/pi-ai": "1.4.0",
        "@earendil-works/pi-codemode": "1.4.0",
        "@earendil-works/pi-coding-agent": "1.4.0",
        "@earendil-works/pi-durable": "1.4.0",
        "@earendil-works/pi-mcp": "1.4.0",
        "@mozilla/readability": "0.6.0",
        "@pierre/diffs": "1.5.2",
        "@xterm/addon-clipboard": "0.2.0",
        "@xterm/addon-fit": "0.11.0",
        "@xterm/addon-unicode11": "0.9.0",
        "@xterm/xterm": "6.0.0",
        "cmdk": "1.1.1",
        "linkedom": "0.18.14",
        "node-pty": "1.1.0",
        "radix-ui": "1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "10.1.0",
        "react-zoom-pan-pinch": "4.2.0",
        "remark-gfm": "4.0.1",
        "shiki": "4.5.0",
        "sonner": "^2.0.8",
        "transcribe-cpp": "0.3.1",
        "turndown": "7.2.4",
        "typebox": "1.3.27",
        "web-push": "3.6.7"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/turndown": "5.0.6",
        "@types/web-push": "3.6.4",
        "@vitejs/plugin-react": "^6.1.2",
        "clsx": "^2.1.1",
        "lucide-react": "^1.61.0",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "oxlint-tsgolint": "^7.0.2005",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.5"
    },
    "dependenciesMeta": {
        "@vantuh/pi-kiro-acp": {
            "injected": true
        }
    },
    "optionalDependencies": {
        "@vantuh/pi-kiro-acp": "file:../pi-kiro-acp"
    },
    "engines": {
        "node": ">=26"
    }
}
